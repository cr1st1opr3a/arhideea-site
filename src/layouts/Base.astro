---
import '@fontsource-variable/inter-tight';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { langOf, t, site, counterpart } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  current?: 'home' | 'proiecte' | 'contact';
}
const l = langOf(Astro);
const T = t(l);
const SITE = site(l);
const { title, description = SITE.description, image, current } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${T.defaultTitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const other = new URL(counterpart(Astro.url.pathname), Astro.site);
const roUrl = l === 'ro' ? canonical : other;
const enUrl = l === 'en' ? canonical : other;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---
<!doctype html>
<html lang={T.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#0F4C5C" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={T.ogLocale} />
  <link rel="alternate" hreflang="ro" href={roUrl} />
  <link rel="alternate" hreflang="en" href={enUrl} />
  <link rel="alternate" hreflang="x-default" href={roUrl} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <script is:inline>document.documentElement.classList.add('js');</script>
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#continut">{T.skip}</a>
  <Header current={current} />
  <main id="continut">
    <slot />
  </main>
  <Footer />
</body>
</html>
