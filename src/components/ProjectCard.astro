---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { langOf, t, url, proj } from '../i18n';
import { cityOf } from '../lib/city';
interface Props { project: CollectionEntry<'projects'> }
const { project: p } = Astro.props;
const d = p.data;
const l = langOf(Astro);
const T = t(l);
const x = proj(p, l);
const facts = x.highlights.length ? x.highlights : [x.summary];
const href = url.project(l, p.id);
---
<article class="card" data-card data-categories={d.categories.join('|')} data-city={cityOf(d.location)} data-structure={d.structure} data-gross={d.area.gross}>
  <a class="card__media duo" href={href}>
    <Image src={d.cover} alt="" widths={[400, 640, 900]} sizes="(min-width: 1100px) 390px, (min-width: 700px) 46vw, 100vw" class="card__img" />
    <span class="duo__cap">
      <span class="duo__meta">{x.location ?? x.categories[0]}</span>
      <h3 class="duo__name card__title">{x.title}</h3>
    </span>
  </a>
  <details class="card__facts">
    <summary><span class="card__sign" aria-hidden="true"></span>{T.factsSummary}</summary>
    <ul>
      {facts.map((f) => <li>{f}</li>)}
    </ul>
  </details>
  <a class="card__open link-arrow" href={href} aria-label={T.openLabel(x.title)}>{T.open} →</a>
</article>

<style>
  .card {
    display: grid; grid-template-columns: 1fr auto; grid-template-areas: 'media media' 'facts open';
    background: var(--surface); border: 1px solid var(--line);
    transition: border-color .25s, box-shadow .25s;
  }
  .card:hover { border-color: var(--grey-3); box-shadow: 0 10px 30px -18px rgba(10, 54, 64, .35); }
  .card__media { grid-area: media; aspect-ratio: 4 / 3; }
  .card__facts { grid-area: facts; padding: 8px 22px 12px; align-self: start; }
  .card__open { grid-area: open; padding: 8px 22px 12px 0; align-self: start; }
  summary {
    list-style: none; cursor: pointer; min-height: 44px; display: inline-flex; align-items: center; gap: 8px;
    font-size: 14px; color: var(--accent);
  }
  summary::-webkit-details-marker { display: none; }
  .card__sign { width: 18px; height: 18px; border: 1px solid var(--accent); position: relative; flex: none; }
  .card__sign::before, .card__sign::after { content: ''; position: absolute; left: 50%; top: 50%; background: var(--accent); transform: translate(-50%, -50%); }
  .card__sign::before { width: 8px; height: 1.5px; }
  .card__sign::after { width: 1.5px; height: 8px; transition: transform .2s; }
  details[open] .card__sign::after { transform: translate(-50%, -50%) scaleY(0); }
  ul {
    list-style: none; margin: 4px 0 0; padding: 10px 0 0; border-top: 1px solid var(--line);
    display: flex; flex-direction: column; gap: 8px; font-size: 14px; line-height: 1.45;
    grid-column: 1 / -1;
  }
  details[open] ul { animation: rise .35s var(--ease) both; }
  li { display: flex; gap: 10px; }
  li::before { content: ''; width: 6px; height: 6px; margin-top: 7px; flex: none; background: var(--green); }

  /* Shown/hidden and entrance states, set by the grid script */
  :global(.js) .card[data-hidden] { display: none; }
  :global(.js) .card[data-enter] { animation: rise .55s var(--ease) both; animation-delay: var(--delay, 0ms); }
  :global(.js) .card[data-wait] { opacity: 0; }
</style>
