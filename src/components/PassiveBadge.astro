---
// Certified Passive House Designer logo. The current file is only 26×27 px;
// replace public/logos/passive-house-designer.png with a larger one (or SVG) and raise the size below.
---
<div class="badge">
  <img class="badge__mark" src="/logos/passive-house-designer.png" alt="Certified Passive House Designer" width="26" height="27" />
  <span class="badge__text"><strong>Certified Passive House Designer</strong> Proiectant certificat de Passive House Institute</span>
</div>

<style>
  .badge { display: flex; align-items: center; gap: 14px; padding: 14px 18px 14px 14px; background: var(--surface); border: 1px solid var(--line); }
  .badge__mark { width: 52px; height: 54px; flex: none; image-rendering: auto; }
  .badge__text { max-width: 210px; font-size: 13px; line-height: 1.4; color: var(--text-2); display: flex; flex-direction: column; gap: 2px; }
  .badge__text strong { font-size: 14px; color: var(--ink); }
</style>
