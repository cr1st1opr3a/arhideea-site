---
// Arhideea logo, traced to vector from the original (public/logos/arhideea-original.jpg).
interface Props { inverse?: boolean }
const { inverse = false } = Astro.props;
---
<img
  class:list={['logo', { 'logo--inverse': inverse }]}
  src={inverse ? '/logos/arhideea-light.svg' : '/logos/arhideea.svg'}
  alt="Arhideea arhitectură · design"
  width="2400"
  height="736"
/>

<style>
  .logo { display: block; height: 46px; width: auto; }
  .logo--inverse { height: 52px; }
  @media (max-width: 520px) { .logo { height: 38px; } }
</style>
