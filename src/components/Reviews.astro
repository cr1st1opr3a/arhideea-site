---
// Client reviews copied from the Google Business profile (Setări site → Recenzii in the admin).
// The section stays hidden until at least one review is added.
import { REVIEWS } from '../site';
const items = (REVIEWS?.items ?? []).filter((r) => r.text && r.author);
const stars = (n = 5) => '★★★★★'.slice(0, Math.max(0, Math.min(5, Math.round(n))));
---
{items.length > 0 && (
<section id="recenzii" class="reviews">
  <div class="wrap">
    <div class="section-head">
      <h2>{REVIEWS.title}</h2>
      {REVIEWS.rating && (
        <p class="reviews__score">
          <span class="reviews__big">{REVIEWS.rating}</span>
          <span class="reviews__stars" aria-hidden="true">{stars(parseFloat(REVIEWS.rating.replace(',', '.')))}</span>
          <span>{REVIEWS.count ? `${REVIEWS.count} recenzii pe Google` : 'pe Google'}</span>
        </p>
      )}
      {!REVIEWS.rating && <p class="reviews__score">Recenzii lăsate pe Google</p>}
    </div>
    <div class="reviews__track" data-reviews>
      {items.map((r) => (
        <figure class="review">
          {r.rating && <span class="review__stars" aria-label={`${r.rating} din 5 stele`}>{stars(r.rating)}</span>}
          <blockquote>{r.text}</blockquote>
          <figcaption><strong>{r.author}</strong>{r.date && <span> · {r.date}</span>}</figcaption>
        </figure>
      ))}
    </div>
    {REVIEWS.googleUrl && (
      <a class="link-arrow reviews__all" href={REVIEWS.googleUrl} target="_blank" rel="noopener">Toate recenziile pe Google →</a>
    )}
  </div>
</section>
)}

<style>
  .reviews { background: var(--surface); border-block: 1px solid var(--line); }
  .reviews .wrap { padding-block: 96px; }
  .section-head h2 { font-size: clamp(30px, 3.4vw, 40px); }
  .reviews__score { display: flex; align-items: baseline; gap: 10px; font-size: 15px; color: var(--text-2); }
  .reviews__big { font-size: 40px; font-weight: 700; color: var(--petrol-d); letter-spacing: -0.03em; }
  .reviews__stars, .review__stars { color: #E8A317; letter-spacing: 2px; }
  .reviews__track {
    display: grid; grid-auto-flow: column; grid-auto-columns: minmax(min(85%, 360px), 1fr);
    gap: 24px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 12px;
    scrollbar-width: thin;
  }
  .review { margin: 0; scroll-snap-align: start; background: var(--bg); padding: 28px; display: flex; flex-direction: column; gap: 16px; border-left: 3px solid var(--green); }
  blockquote { margin: 0; font-size: 17px; line-height: 1.6; color: var(--ink); flex: 1; }
  figcaption { font-size: 14px; color: var(--text-2); }
  figcaption strong { color: var(--petrol-d); }
  .reviews__all { margin-top: 20px; }
</style>
