---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
interface Props { projects: CollectionEntry<'projects'>[] }
const { projects } = Astro.props;
const n = projects.length;
const pad = (x: number) => String(x).padStart(2, '0');
---
<section class="wrap slider" aria-roledescription="carusel" aria-label="Proiecte în prim-plan" data-slider>
  <div class="slider__stage">
    {projects.map((p, i) => (
      <article
        class="slide"
        data-slide
        aria-roledescription="diapozitiv"
        aria-label={`${i + 1} din ${n}: ${p.data.title}`}
        aria-hidden={i === 0 ? 'false' : 'true'}
        data-active={i === 0 ? '' : undefined}
      >
        <Image
          src={p.data.cover}
          alt={p.data.title}
          widths={[800, 1280, 1920]}
          sizes="(min-width: 1280px) 1200px, 100vw"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
          class="slide__img"
        />
        <div class="slide__card">
          <span class="tag">{p.data.categories[0]}</span>
          <h2 class="slide__title">{p.data.title}{p.data.location && <span class="slide__loc">, {p.data.location}</span>}</h2>
          <p class="slide__line">{p.data.highlights.length ? p.data.highlights.join(' · ') : p.data.summary}</p>
          <a class="link-arrow" href={`/proiecte/${p.id}/`} tabindex={i === 0 ? undefined : '-1'}>Vezi proiectul →</a>
        </div>
      </article>
    ))}
  </div>

  <div class="slider__bar">
    <div class="slider__segs">
      {projects.map((p, i) => (
        <button type="button" class="seg" data-go={i} aria-label={`Arată ${p.data.title}`} aria-current={i === 0 ? 'true' : undefined}>
          <span class="seg__track"><span class="seg__fill"></span></span>
        </button>
      ))}
    </div>
    <span class="slider__count" aria-live="polite"><span data-count>01</span> / {pad(n)}</span>
    <div class="slider__ctrls">
      <button type="button" class="icon-btn" data-prev aria-label="Proiectul anterior"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" /></svg></button>
      <button type="button" class="icon-btn" data-toggle aria-label="Oprește derularea">
        <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3v10M10.5 3v10" /></svg>
        <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3l8 5-8 5z" /></svg>
      </button>
      <button type="button" class="icon-btn" data-next aria-label="Proiectul următor"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg></button>
    </div>
  </div>
</section>

<style>
  .slider__stage {
    position: relative; overflow: hidden; background: var(--grey-2);
    aspect-ratio: 16 / 7.5;
    touch-action: pan-y;
  }
  @media (max-width: 1100px) { .slider__stage { aspect-ratio: 4 / 3; } }
  .slide { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity .9s var(--ease), visibility 0s linear .9s; }
  .slide[data-active] { opacity: 1; visibility: visible; transition: opacity .9s var(--ease), visibility 0s; z-index: 1; }
  .slide :global(.slide__img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.06); transition: transform 7s linear; }
  .slide[data-active] :global(.slide__img) { transform: scale(1); }
  .slide__card {
    position: absolute; left: 32px; bottom: 32px; max-width: 460px;
    background: var(--surface); padding: 26px 28px 14px;
    display: flex; flex-direction: column; gap: 12px;
    transform: translateY(12px); opacity: 0; transition: transform .7s var(--ease) .25s, opacity .7s var(--ease) .25s;
  }
  .slide[data-active] .slide__card { transform: none; opacity: 1; }
  .slide__title { font-size: clamp(24px, 2.6vw, 30px); }
  .slide__loc { color: var(--text-2); font-weight: 400; }
  .slide__line { font-size: 16px; color: var(--text-2); }

  .slider__bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; padding-top: 8px; }
  .slider__segs { flex: 1 1 320px; display: flex; gap: 8px; }
  .seg { flex: 1; min-height: 44px; padding: 0; border: 0; background: none; cursor: pointer; display: flex; align-items: center; }
  .seg__track { position: relative; display: block; width: 100%; height: 3px; background: var(--line); overflow: hidden; }
  .seg__fill { position: absolute; inset: 0 auto 0 0; width: 0; background: var(--petrol); }
  .seg[data-done] .seg__fill { width: 100%; }
  .seg[aria-current='true'] .seg__fill { animation: fill var(--slide-ms, 6000ms) linear forwards; }
  .slider[data-paused] .seg[aria-current='true'] .seg__fill { animation-play-state: paused; }
  .slider__count { font-size: 14px; color: var(--text-2); font-variant-numeric: tabular-nums; }
  .slider__ctrls { display: flex; gap: 8px; }
  .i-play { display: none; }
  .slider[data-paused] .i-play { display: block; }
  .slider[data-paused] .i-pause { display: none; }

  @media (max-width: 700px) {
    .slider__stage { aspect-ratio: auto; min-height: 0; height: auto; display: grid; }
    .slide { position: relative; grid-area: 1 / 1; display: flex; flex-direction: column; }
    .slide :global(.slide__img) { height: auto; aspect-ratio: 4 / 3; }
    .slide__card { position: relative; left: auto; bottom: auto; max-width: none; padding: 20px 4px 4px; background: var(--bg); }
  }
</style>

<script>
  const DURATION = 6000;
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const segs = [...root.querySelectorAll<HTMLButtonElement>('.seg')];
    const count = root.querySelector('[data-count]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const stage = root.querySelector<HTMLElement>('.slider__stage')!;
    if (slides.length < 2) { root.querySelector('.slider__bar')?.remove(); return; }

    root.style.setProperty('--slide-ms', DURATION + 'ms');
    let idx = 0;
    let timer: number | undefined;
    let started = 0;
    let remaining = DURATION;
    let paused = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let hover = false;

    const render = () => {
      slides.forEach((s, i) => {
        const on = i === idx;
        s.toggleAttribute('data-active', on);
        s.setAttribute('aria-hidden', String(!on));
        s.querySelectorAll('a').forEach((a) => (on ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
      });
      segs.forEach((g, i) => {
        // Re-start the progress animation on the active segment.
        g.removeAttribute('aria-current');
        g.toggleAttribute('data-done', i < idx);
      });
      void root.offsetWidth;
      segs[idx].setAttribute('aria-current', 'true');
      count.textContent = String(idx + 1).padStart(2, '0');
      root.toggleAttribute('data-paused', paused || hover);
      toggle.setAttribute('aria-label', paused ? 'Pornește derularea' : 'Oprește derularea');
    };

    const stop = () => { if (timer) { clearTimeout(timer); timer = undefined; remaining -= Date.now() - started; } };
    const run = () => {
      stop();
      if (paused || hover || document.hidden) return;
      started = Date.now();
      timer = window.setTimeout(() => go(idx + 1), Math.max(0, remaining));
    };
    const go = (i: number) => {
      idx = (i + slides.length) % slides.length;
      remaining = DURATION;
      if (timer) { clearTimeout(timer); timer = undefined; }
      render();
      run();
    };

    root.querySelector('[data-prev]')!.addEventListener('click', () => go(idx - 1));
    root.querySelector('[data-next]')!.addEventListener('click', () => go(idx + 1));
    segs.forEach((g) => g.addEventListener('click', () => go(Number(g.dataset.go))));
    toggle.addEventListener('click', () => { paused = !paused; render(); paused ? stop() : run(); });
    stage.addEventListener('mouseenter', () => { hover = true; stop(); root.setAttribute('data-paused', ''); });
    stage.addEventListener('mouseleave', () => { hover = false; root.toggleAttribute('data-paused', paused); run(); });
    root.addEventListener('focusin', () => { hover = true; stop(); root.setAttribute('data-paused', ''); });
    root.addEventListener('focusout', (e) => {
      if (root.contains(e.relatedTarget as Node)) return;
      hover = false; root.toggleAttribute('data-paused', paused); run();
    });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : run()));

    // Swipe on touch screens.
    let x0: number | null = null;
    stage.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') x0 = e.clientX; });
    stage.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0; x0 = null;
      if (Math.abs(dx) > 40) go(idx + (dx < 0 ? 1 : -1));
    });

    render();
    run();
  });
</script>
