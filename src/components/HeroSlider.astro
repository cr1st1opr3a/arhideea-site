---
// Full-bleed opening slider: featured projects ("În sliderul de pe prima pagină" in the admin),
// with the homepage headline laid over the photo.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { HERO } from '../site';
interface Props { projects: CollectionEntry<'projects'>[] }
const { projects } = Astro.props;
const n = projects.length;
const pad = (x: number) => String(x).padStart(2, '0');
---
<section class="hero" aria-roledescription="carusel" aria-label="Proiecte în prim-plan" data-slider>
  <div class="hero__stage">
    {projects.map((p, i) => (
      <figure class="slide" data-slide aria-hidden={i === 0 ? 'false' : 'true'} data-active={i === 0 ? '' : undefined}>
        <Image
          src={p.data.cover}
          alt={p.data.title}
          widths={[800, 1280, 1920, 2400]}
          sizes="100vw"
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
          class="slide__img"
        />
        <span class="slide__shade" aria-hidden="true"></span>
        <figcaption class="slide__cap">
          <a href={`/proiecte/${p.id}/`} tabindex={i === 0 ? undefined : '-1'}>
            <span class="slide__cat">{p.data.categories[0]}</span>
            <span class="slide__name">{p.data.title}{p.data.location && `, ${p.data.location}`} →</span>
          </a>
        </figcaption>
      </figure>
    ))}
    <div class="wrap hero__text">
      <span class="hero__eyebrow">{HERO.eyebrow}</span>
      <h1 class="hero__title">{HERO.title}</h1>
    </div>
  </div>

  {n > 1 && (
    <div class="hero__bar wrap">
      <div class="hero__segs">
        {projects.map((p, i) => (
          <button type="button" class="seg" data-go={i} aria-label={`Arată ${p.data.title}`} aria-current={i === 0 ? 'true' : undefined}>
            <span class="seg__track"><span class="seg__fill"></span></span>
          </button>
        ))}
      </div>
      <span class="hero__count" aria-live="polite"><span data-count>01</span>/{pad(n)}</span>
      <div class="hero__ctrls">
        <button type="button" class="hbtn" data-prev aria-label="Proiectul anterior"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" /></svg></button>
        <button type="button" class="hbtn" data-toggle aria-label="Oprește derularea">
          <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3v10M10.5 3v10" /></svg>
          <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3l8 5-8 5z" /></svg>
        </button>
        <button type="button" class="hbtn" data-next aria-label="Proiectul următor"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg></button>
      </div>
    </div>
  )}
</section>

<style>
  .hero { position: relative; background: var(--petrol-d); color: #fff; }
  .hero__stage { position: relative; height: clamp(520px, calc(100svh - 73px - 64px), 920px); overflow: hidden; touch-action: pan-y; }
  .slide { position: absolute; inset: 0; margin: 0; opacity: 0; visibility: hidden; transition: opacity 1.1s var(--ease), visibility 0s linear 1.1s; }
  .slide[data-active] { opacity: 1; visibility: visible; transition: opacity 1.1s var(--ease), visibility 0s; z-index: 1; }
  .slide :global(.slide__img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.06); transition: transform 8s linear; }
  .slide[data-active] :global(.slide__img) { transform: scale(1); }
  .slide__shade { position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(to top, rgba(8, 30, 36, .82) 0%, rgba(8, 30, 36, .45) 34%, rgba(8, 30, 36, 0) 64%); }
  .hero__text { position: absolute; left: 0; right: 0; bottom: clamp(32px, 6vw, 72px); z-index: 3; display: flex; flex-direction: column; gap: 18px; pointer-events: none; }
  .hero__eyebrow { display: inline-flex; align-items: center; gap: 10px; font-size: 13px; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.85); }
  .hero__eyebrow::before { content: ''; width: 24px; height: 2px; background: var(--red); }
  .hero__title { text-shadow: 0 1px 24px rgba(0, 0, 0, .18); color: #fff; font-weight: 300; font-size: clamp(38px, 6.4vw, 92px); line-height: 1.02; letter-spacing: -0.04em; max-width: 14ch; text-wrap: balance; }
  .slide__cap { text-shadow: 0 1px 10px rgba(0, 0, 0, .45); position: absolute; z-index: 4; right: var(--gutter); bottom: clamp(32px, 6vw, 72px); max-width: 320px; text-align: right; }
  .slide__cap a { color: #fff; display: flex; flex-direction: column; gap: 4px; padding: 6px 0; }
  .slide__cap a:hover .slide__name { color: var(--green); }
  .slide__cat { font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.75); }
  .slide__name { font-size: 17px; }
  @media (max-width: 760px) {
    .hero__stage { height: clamp(460px, 78svh, 760px); }
    .slide__cap { left: var(--gutter); right: var(--gutter); bottom: 18px; max-width: none; text-align: left; }
    .slide__cap a { flex-direction: row; gap: 10px; align-items: baseline; }
    .slide__name { font-size: 15px; }
    .hero__text { bottom: 72px; }
  }

  .hero__bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; min-height: 64px; }
  .hero__segs { flex: 1 1 260px; display: flex; gap: 8px; }
  .seg { flex: 1; min-height: 44px; padding: 0; border: 0; background: none; cursor: pointer; display: flex; align-items: center; }
  .seg__track { position: relative; display: block; width: 100%; height: 2px; background: rgba(255,255,255,.22); overflow: hidden; }
  .seg__fill { position: absolute; inset: 0 auto 0 0; width: 0; background: #fff; }
  .seg[data-done] .seg__fill { width: 100%; }
  .seg[aria-current='true'] .seg__fill { animation: fill var(--slide-ms, 6500ms) linear forwards; }
  [data-paused] .seg[aria-current='true'] .seg__fill { animation-play-state: paused; }
  .hero__count { font-size: 14px; color: rgba(255,255,255,.8); font-variant-numeric: tabular-nums; letter-spacing: .04em; }
  .hero__ctrls { display: flex; gap: 4px; }
  .hbtn { width: 44px; height: 44px; border: 1px solid rgba(255,255,255,.3); border-radius: 50%; background: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: border-color .2s, background .2s; }
  .hbtn:hover { border-color: #fff; background: rgba(255,255,255,.08); }
  .hbtn svg { width: 15px; height: 15px; stroke: #fff; fill: none; stroke-width: 1.6; }
  .i-play { display: none; }
  [data-paused] .i-play { display: block; }
  [data-paused] .i-pause { display: none; }
</style>

<script>
  const DURATION = 6500;
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const segs = [...root.querySelectorAll<HTMLButtonElement>('.seg')];
    const count = root.querySelector('[data-count]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]');
    const stage = root.querySelector<HTMLElement>('.hero__stage')!;
    if (slides.length < 2 || !toggle) return;

    root.style.setProperty('--slide-ms', DURATION + 'ms');
    let idx = 0, timer: number | undefined, started = 0, remaining = DURATION;
    let paused = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let hover = false;

    const render = () => {
      slides.forEach((s, i) => {
        const on = i === idx;
        s.toggleAttribute('data-active', on);
        s.setAttribute('aria-hidden', String(!on));
        s.querySelectorAll('a').forEach((a) => (on ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
      });
      segs.forEach((g, i) => { g.removeAttribute('aria-current'); g.toggleAttribute('data-done', i < idx); });
      void root.offsetWidth;
      segs[idx].setAttribute('aria-current', 'true');
      if (count) count.textContent = String(idx + 1).padStart(2, '0');
      root.toggleAttribute('data-paused', paused || hover);
      toggle.setAttribute('aria-label', paused ? 'Pornește derularea' : 'Oprește derularea');
    };
    const stop = () => { if (timer) { clearTimeout(timer); timer = undefined; remaining -= Date.now() - started; } };
    const run = () => {
      stop();
      if (paused || hover || document.hidden) return;
      started = Date.now();
      timer = window.setTimeout(() => go(idx + 1), Math.max(0, remaining));
    };
    const go = (i: number) => {
      idx = (i + slides.length) % slides.length; remaining = DURATION;
      if (timer) { clearTimeout(timer); timer = undefined; }
      render(); run();
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => go(idx - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(idx + 1));
    segs.forEach((g) => g.addEventListener('click', () => go(Number(g.dataset.go))));
    toggle.addEventListener('click', () => { paused = !paused; render(); paused ? stop() : run(); });
    root.addEventListener('focusin', () => { hover = true; stop(); root.setAttribute('data-paused', ''); });
    root.addEventListener('focusout', (e) => {
      if (root.contains(e.relatedTarget as Node)) return;
      hover = false; root.toggleAttribute('data-paused', paused); run();
    });
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : run()));
    let x0: number | null = null;
    stage.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') x0 = e.clientX; });
    stage.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0; x0 = null;
      if (Math.abs(dx) > 40) go(idx + (dx < 0 ? 1 : -1));
    });
    render(); run();
  });
</script>
