---
// Contact block with the office map. The Google map loads only after a click,
// so no Google cookies are set for visitors who don't open it.
import { langOf, t, site } from '../i18n';
const l = langOf(Astro);
const T = t(l);
const SITE = site(l);
const CONTACT = SITE.contact;
interface Props { headingLevel?: 'h1' | 'h2' }
const { headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
const q = encodeURIComponent(CONTACT.mapQuery || `${CONTACT.address}, ${CONTACT.city}`);
const embed = `https://www.google.com/maps?q=${q}&z=16&output=embed`;
const gmaps = `https://www.google.com/maps/search/?api=1&query=${q}`;
const waze = `https://waze.com/ul?q=${q}&navigate=yes`;
const tel = SITE.phone ? SITE.phone.replace(/[^\d+]/g, '') : '';
---
<section id="contact" class="wrap contact">
  <div class="contact__info">
    <H class="contact__title">{CONTACT.title}</H>
    {CONTACT.intro && <p class="contact__intro">{CONTACT.intro}</p>}
    <dl class="contact__list">
      <div><dt>{T.address}</dt><dd>{CONTACT.address}<br />{CONTACT.city}</dd></div>
      {SITE.phone && <div><dt>{T.phone}</dt><dd><a href={`tel:${tel}`}>{SITE.phone}</a></dd></div>}
      <div><dt>Email</dt><dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd></div>
      {CONTACT.hours && <div><dt>{T.hours}</dt><dd>{CONTACT.hours}</dd></div>}
    </dl>
    <div class="contact__links">
      <a class="btn btn--solid" href={gmaps} target="_blank" rel="noopener">{T.gmaps}</a>
      <a class="btn" href={waze} target="_blank" rel="noopener">{T.waze}</a>
    </div>
  </div>
  <div class="map" data-map={embed} data-map-title={T.mapTitle}>
    <div class="map__placeholder">
      <svg class="map__grid" viewBox="0 0 400 300" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 70 H400 M0 160 H400 M0 240 H400 M90 0 V300 M210 0 V300 M320 0 V300 M0 300 L400 40" />
      </svg>
      <span class="map__pin" aria-hidden="true"></span>
      <button type="button" class="btn btn--solid map__btn">{T.showMap}</button>
      <p class="map__note">{T.mapNote}</p>
    </div>
  </div>
</section>

<style>
  .contact { padding-block: 104px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 48px; align-items: stretch; }
  .contact__info { display: flex; flex-direction: column; gap: 24px; }
  .contact__title { font-size: clamp(30px, 3.4vw, 40px); }
  h1.contact__title { font-size: clamp(40px, 5vw, 64px); }
  .contact__intro { font-size: 18px; color: var(--text-2); max-width: 46ch; }
  .contact__list { margin: 0; display: flex; flex-direction: column; border-top: 1px solid var(--line); }
  .contact__list > div { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  dt { font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--text-2); padding-top: 3px; }
  dd { margin: 0; font-size: 18px; }
  dd a { color: var(--ink); border-bottom: 2px solid var(--green); }
  dd a:hover { color: var(--accent); }
  .contact__links { display: flex; flex-wrap: wrap; gap: 12px; }

  .map { position: relative; min-height: 380px; background: var(--grey-1); border: 1px solid var(--line); overflow: hidden; }
  .map :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .map__placeholder { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; padding: 24px; text-align: center; }
  .map__grid { position: absolute; inset: 0; width: 100%; height: 100%; }
  .map__grid path { stroke: var(--grey-2); stroke-width: 6; fill: none; }
  .map__pin { position: relative; width: 22px; height: 22px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); background: var(--red); box-shadow: 0 0 0 6px rgba(226, 35, 26, .15); margin-bottom: 8px; }
  .map__btn, .map__note { position: relative; }
  .map__note { font-size: 13px; color: var(--text-2); max-width: 32ch; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = box.dataset.map!;
      f.title = box.dataset.mapTitle ?? "";
      f.loading = 'lazy';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      f.allowFullscreen = true;
      box.replaceChildren(f);
    });
  });
</script>
