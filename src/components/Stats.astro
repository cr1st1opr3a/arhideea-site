---
// Numbers band. Values come from Setări site → Banda cu cifre in the admin.
interface Props { items: { value: number; suffix?: string; label: string }[] }
import { langOf, t } from '../i18n';
const { items } = Astro.props;
const T = t(langOf(Astro));
---
{items.length > 0 && (
<section class="stats" aria-label={T.statsLabel}>
  <div class="wrap stats__in">
    {items.map((it) => (
      <div class="stat">
        <span class="stat__num"><span data-count-to={it.value}>{it.value}</span>{it.suffix && <span class="stat__suffix">{it.suffix}</span>}</span>
        <span class="stat__label">{it.label}</span>
      </div>
    ))}
  </div>
</section>
)}

<style>
  .stats { background: var(--petrol); color: #fff; margin-top: 88px; }
  .stats__in { padding-block: 56px; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 32px; }
  .stat { display: flex; flex-direction: column; gap: 8px; padding-left: 20px; border-left: 2px solid var(--green); }
  .stat__num { font-size: clamp(48px, 5vw, 64px); font-weight: 700; letter-spacing: -0.04em; line-height: 1; font-variant-numeric: tabular-nums; }
  .stat__suffix { color: var(--green); margin-left: 2px; }
  .stat__label { font-size: 16px; color: var(--on-petrol); }
</style>

<script>
  const nums = document.querySelectorAll<HTMLElement>('[data-count-to]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const to = Number(el.dataset.countTo);
        const t0 = performance.now();
        el.textContent = '0';
        const step = (t: number) => {
          const k = Math.min(1, (t - t0) / 1400);
          el.textContent = String(Math.round(to * (1 - Math.pow(1 - k, 3))));
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
    }, { threshold: 0.4 });
    nums.forEach((el) => io.observe(el));
  }
</script>
