---
import Base from '../layouts/Base.astro';
---
<Base title="Pagina nu există">
  <section class="wrap nf">
    <span class="eyebrow">Eroare 404</span>
    <h1>Pagina aceasta nu mai există.</h1>
    <p>Poate a fost mutată odată cu noul site. Proiectele sunt toate aici:</p>
    <a class="btn btn--solid" href="/proiecte/">Vezi proiectele</a>
  </section>
</Base>

<style>
  .nf { padding-block: 120px; display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .nf h1 { font-size: clamp(36px, 5vw, 64px); max-width: 16ch; }
  .nf p { font-size: 18px; color: var(--text-2); }
</style>
