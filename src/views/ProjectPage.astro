---
import { render, type CollectionEntry } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { langOf, t, url, proj } from '../i18n';

interface Props {
  project: CollectionEntry<'projects'>;
  prev: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'>;
}
const { project, prev, next } = Astro.props;
const d = project.data;
const l = langOf(Astro);
const T = t(l);
const x = proj(project, l);
const { Content } = await render(project);
const hasBody = (project.body ?? '').trim().length > 0;

const photos = (d.gallery.length ? d.gallery : [{ src: d.cover, caption: undefined }]).map((g, i) => ({ ...g, caption: d.gallery.length ? x.caption(i) : undefined }));
const og = await getImage({ src: d.cover, width: 1200, format: 'jpg' });

const mp = (n: number) => `${Math.round(n).toLocaleString(T.numberLocale)} ${T.sqm}`;
const projectRows = [
  x.location && { k: T.location, v: x.location },
  { k: T.category, v: x.categories.join(', ') },
  d.year && { k: T.year, v: d.year },
  d.area.land && { k: T.land, v: mp(d.area.land) },
  d.area.built && { k: T.built, v: mp(d.area.built) },
  d.area.gross && { k: T.gross, v: mp(d.area.gross) },
  ...x.facts,
].filter(Boolean) as { k: string; v: string }[];
const tabs = [
  { id: 'proiect', label: T.sheet, rows: projectRows },
  ...(x.technical.length ? [{ id: 'tehnic', label: T.technical, rows: x.technical }] : []),
];
---
<Base title={`${x.title}${x.location ? `, ${x.location}` : ''}`} description={x.summary} image={og.src} current="proiecte">
  <section class="wrap head">
    <a class="back link-arrow" href={url.projects(l)}>{T.allProjects}</a>
    <div class="head__row">
      <div class="head__title">
        <div class="head__tags">{x.categories.map((c) => <span class="tag">{c}</span>)}</div>
        <h1>{x.title}</h1>
      </div>
      {(x.location || d.year) && <span class="eyebrow">{[x.location, d.year].filter(Boolean).join(' · ')}</span>}
    </div>
  </section>

  <section class="wrap gallery" aria-roledescription={T.carousel} aria-label={T.photos} data-gallery>
    <div class="gallery__stage">
      {photos.map((ph, i) => (
        <figure class="shot" data-shot aria-hidden={i === 0 ? 'false' : 'true'} data-active={i === 0 ? '' : undefined}>
          <Image
            src={ph.src}
            alt={ph.caption ?? T.photo(x.title, i + 1)}
            widths={[800, 1280, 1920]}
            sizes="(min-width: 1280px) 1200px, 100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            class="shot__img"
          />
          {ph.caption && <figcaption>{ph.caption}</figcaption>}
        </figure>
      ))}
      {photos.length > 1 && (
        <>
          <button type="button" class="nav nav--prev" data-prev aria-label={T.prevPhoto}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3L5 8l5 5" /></svg></button>
          <button type="button" class="nav nav--next" data-next aria-label={T.nextPhoto}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3l5 5-5 5" /></svg></button>
          <span class="gallery__count" aria-live="polite"><span data-count>1</span> / {photos.length}</span>
        </>
      )}
    </div>
    {photos.length > 1 && (
      <div class="thumbs">
        {photos.map((ph, i) => (
          <button type="button" class="thumb" data-thumb={i} aria-label={`${T.photoN(i + 1)}${ph.caption ? `: ${ph.caption}` : ''}`} aria-current={i === 0 ? 'true' : undefined}>
            <Image src={ph.src} alt="" width={240} class="thumb__img" />
          </button>
        ))}
      </div>
    )}
  </section>

  {d.video && (
    <section class="wrap video">
      <h2 class="video__title">{T.video}</h2>
      <video class="video__el" controls preload="none" playsinline poster={d.video.replace(/\.mp4$/, '.jpg')}>
        <source src={d.video} type="video/mp4" />
      </video>
    </section>
  )}

  <section class="wrap about">
    <div class="about__text">
      <h2>{T.about}</h2>
      <p class="about__lede">{x.summary}</p>
      {hasBody && <div class="prose"><Content /></div>}
    </div>
    <div class="data">
      {tabs.length > 1 ? (
        <div class="data__tabs" role="tablist" aria-label={T.dataLabel} data-tabs>
          {tabs.map((t, i) => (
            <button type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? undefined : '-1'}>{t.label}</button>
          ))}
        </div>
      ) : (
        <h3 class="data__single">{tabs[0].label}</h3>
      )}
      {tabs.map((t, i) => (
        <dl class="data__panel" id={`panel-${t.id}`} role={tabs.length > 1 ? 'tabpanel' : undefined} aria-labelledby={tabs.length > 1 ? `tab-${t.id}` : undefined} hidden={i !== 0}>
          {t.rows.map((r, j) => (
            <div class="row" style={`--i:${j}`}><dt>{r.k}</dt><dd>{r.v}</dd></div>
          ))}
        </dl>
      ))}
    </div>
  </section>

  {d.quote && (
    <section class="quote">
      <div class="wrap quote__in">
        <blockquote>{l === 'en' ? `“${x.quote?.text}”` : `„${x.quote?.text}”`}</blockquote>
        {d.quote.author && <span class="quote__by">{d.quote.author}</span>}
      </div>
    </section>
  )}

  <nav class="wrap pager" aria-label={T.otherProjects}>
    <a class="pager__item" href={url.project(l, prev.id)}>
      <Image src={prev.data.cover} alt="" width={192} class="pager__img" />
      <span><span class="pager__dir">{T.prevP}</span><span class="pager__name">{proj(prev, l).title}</span></span>
    </a>
    <a class="pager__item pager__item--next" href={url.project(l, next.id)}>
      <span><span class="pager__dir">{T.nextP}</span><span class="pager__name">{proj(next, l).title}</span></span>
      <Image src={next.data.cover} alt="" width={192} class="pager__img" />
    </a>
  </nav>
</Base>

<style>
  .head { padding-block: 32px 32px; }
  .back { font-weight: 400; }
  .head__row { margin-top: 12px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px; }
  .head__title { display: flex; flex-direction: column; gap: 16px; }
  .head__tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .head h1 { font-size: clamp(40px, 6vw, 84px); line-height: .98; letter-spacing: -0.04em; }

  .gallery__stage { position: relative; aspect-ratio: 16 / 8.5; overflow: hidden; background: var(--grey-2); }
  @media (max-width: 760px) { .gallery__stage { aspect-ratio: 4 / 3; } .nav { width: 44px; height: 44px; } .nav--prev { left: 8px; } .nav--next { right: 8px; } }
  .shot { position: absolute; inset: 0; margin: 0; opacity: 0; visibility: hidden; transition: opacity .7s var(--ease), visibility 0s linear .7s; }
  .shot[data-active] { opacity: 1; visibility: visible; transition: opacity .7s var(--ease), visibility 0s; }
  .shot :global(.shot__img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1); transition: transform 6s ease-out; }
  .shot[data-active][data-zoom] :global(.shot__img) { transform: scale(1.04); }
  figcaption { position: absolute; left: 16px; bottom: 16px; background: var(--surface); padding: 6px 10px; font-size: 13px; color: var(--ink); }
  .nav { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; width: 48px; height: 48px; border: 0; background: var(--surface); cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .nav svg { width: 18px; height: 18px; stroke: var(--ink); fill: none; stroke-width: 1.6; }
  .nav:hover { background: var(--grey-1); }
  .nav--prev { left: 16px; } .nav--next { right: 16px; }
  .gallery__count { position: absolute; right: 16px; bottom: 16px; z-index: 2; background: var(--surface); padding: 6px 10px; font-size: 13px; font-variant-numeric: tabular-nums; }
  .thumbs { margin-top: 12px; display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 10px; }
  .thumb { padding: 0; border: 2px solid transparent; background: var(--grey-2); aspect-ratio: 3 / 2; cursor: pointer; opacity: .6; transition: opacity .2s, border-color .2s; overflow: hidden; }
  .thumb:hover { opacity: .9; }
  .thumb[aria-current='true'] { border-color: var(--petrol); opacity: 1; }
  .thumb :global(.thumb__img) { width: 100%; height: 100%; object-fit: cover; }

  .about { padding-block: 80px; display: flex; flex-wrap: wrap; gap: 56px; }
  .about__text { flex: 3 1 520px; display: flex; flex-direction: column; gap: 22px; }
  .about h2 { font-size: 30px; }
  .about__lede { font-size: 20px; line-height: 1.6; }
  .prose { font-size: 18px; line-height: 1.65; color: var(--text-2); display: flex; flex-direction: column; gap: 1em; }
  .prose :global(p) { margin: 0; }
  .data { flex: 2 1 360px; align-self: flex-start; background: var(--surface); border: 1px solid var(--line); }
  .data__tabs { display: flex; border-bottom: 1px solid var(--line); }
  .data__tabs button { flex: 1; min-height: 52px; border: 0; border-bottom: 3px solid transparent; background: none; font-size: 15px; font-weight: 700; color: var(--muted); cursor: pointer; }
  .data__tabs button[aria-selected='true'] { color: var(--petrol-d); border-bottom-color: var(--green); }
  .data__single { font-size: 15px; padding: 16px 24px; border-bottom: 1px solid var(--line); letter-spacing: 0; }
  .data__panel { margin: 0; padding: 8px 24px 20px; }
  .row { display: flex; justify-content: space-between; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line-soft); }
  .row:last-child { border-bottom: 0; }
  .data__panel[data-enter] .row { animation: rise .4s var(--ease) both; animation-delay: calc(var(--i) * 60ms); }
  dt { font-size: 14px; color: var(--text-2); }
  dd { margin: 0; font-size: 15px; font-weight: 700; text-align: right; }

  .quote { background: var(--petrol); color: #fff; }
  .quote__in { padding-block: 64px; display: flex; flex-wrap: wrap; gap: 32px 40px; align-items: center; justify-content: space-between; }
  blockquote { margin: 0; flex: 1 1 520px; font-size: clamp(24px, 3vw, 36px); font-weight: 700; letter-spacing: -0.02em; line-height: 1.25; }
  .quote__by { flex: 0 1 240px; font-size: 15px; color: var(--on-petrol); border-left: 2px solid var(--green); padding-left: 16px; }

  .pager { padding-block: 64px 96px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 24px; }
  .pager__item { display: flex; gap: 18px; align-items: center; background: var(--surface); border: 1px solid var(--line); padding: 14px; transition: border-color .2s; }
  .pager__item:hover { border-color: var(--petrol); }
  .pager__item--next { justify-content: flex-end; text-align: right; }
  .pager__item > span { display: flex; flex-direction: column; gap: 4px; }
  .pager :global(.pager__img) { width: 96px; height: 72px; object-fit: cover; flex: none; }
  .pager__dir { font-size: 13px; color: var(--text-2); }
  .pager__name { font-size: 20px; font-weight: 700; color: var(--petrol-d); letter-spacing: -0.015em; }
  .video { padding-top: 56px; }
  .video__title { font-size: clamp(24px, 2.6vw, 32px); margin-bottom: 20px; }
  .video__el { width: 100%; aspect-ratio: 16 / 9; background: var(--petrol-d); display: block; }
</style>

<script>
  // Gallery: arrows, thumbnails, swipe, slow zoom on the active photo.
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const shots = [...root.querySelectorAll<HTMLElement>('[data-shot]')];
    if (shots.length < 2) return;
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
    const count = root.querySelector('[data-count]');
    const stage = root.querySelector<HTMLElement>('.gallery__stage')!;
    let idx = 0;
    const go = (i: number) => {
      idx = (i + shots.length) % shots.length;
      shots.forEach((s, k) => {
        s.toggleAttribute('data-active', k === idx);
        s.removeAttribute('data-zoom');
        s.setAttribute('aria-hidden', String(k !== idx));
      });
      requestAnimationFrame(() => requestAnimationFrame(() => shots[idx].setAttribute('data-zoom', '')));
      thumbs.forEach((t, k) => (k === idx ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
      if (count) count.textContent = String(idx + 1);
    };
    root.querySelector('[data-prev]')?.addEventListener('click', () => go(idx - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => go(idx + 1));
    thumbs.forEach((t) => t.addEventListener('click', () => go(Number(t.dataset.thumb))));
    stage.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') go(idx - 1);
      if (e.key === 'ArrowRight') go(idx + 1);
    });
    let x0: number | null = null;
    stage.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') x0 = e.clientX; });
    stage.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0; x0 = null;
      if (Math.abs(dx) > 40) go(idx + (dx < 0 ? 1 : -1));
    });
    go(0);
  });

  // Tabs with arrow-key support; rows rise in when a tab opens.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((list) => {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        on ? t.removeAttribute('tabindex') : t.setAttribute('tabindex', '-1');
        const panel = document.getElementById(t.getAttribute('aria-controls')!)!;
        panel.hidden = !on;
        panel.removeAttribute('data-enter');
        if (on) { void panel.offsetWidth; panel.setAttribute('data-enter', ''); }
      });
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const k = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!k) return;
        const n = tabs[(i + k + tabs.length) % tabs.length];
        n.focus(); select(n);
      });
    });
  });
</script>
