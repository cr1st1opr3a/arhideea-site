---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HeroSlider from '../components/HeroSlider.astro';
import Manifesto from '../components/Manifesto.astro';
import Stats from '../components/Stats.astro';
import CategoryRows from '../components/CategoryRows.astro';
import Reviews from '../components/Reviews.astro';
import ContactSection from '../components/ContactSection.astro';
import { langOf, t, site, url } from '../i18n';

const l = langOf(Astro);
const T = t(l);
const SITE = site(l);
const HERO = SITE.hero;
const STATS = SITE.stats;
const TEAM = SITE.team.map((m) => {
  const bare = m.name.replace(/^arh\.\s*/i, '');
  return { ...m, name: l === 'en' ? bare : m.name, initials: bare.split(/\s+/).map((w) => w[0]).join('').slice(0, 2).toUpperCase() };
});

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = projects.filter((p) => p.data.featured);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.company,
  alternateName: SITE.name,
  url: new URL(url.home(l), Astro.site).href,
  email: SITE.email,
  telephone: SITE.phone || undefined,
  description: SITE.description,
  address: { '@type': 'PostalAddress', addressLocality: SITE.city, addressCountry: 'RO' },
  sameAs: [SITE.facebook],
};
---
<Base current="home">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  {featured.length > 0
    ? <HeroSlider projects={featured} />
    : <section class="wrap intro"><h1>{HERO.title}</h1></section>}

  <Manifesto />

  <Stats items={STATS} />

  <CategoryRows projects={projects} />
  <div class="wrap all-link"><a class="btn" href={url.projects(l)}>{T.allN(projects.length)}</a></div>

  <Reviews />

  <section id="atelier" class="team">
    <div class="wrap team__in">
      <h2>{T.studio}</h2>
      <div class="team__people">
        {TEAM.map((m) => (
          <div class="person">
            {m.photo ? <img class="person__img person__img--photo" src={m.photo} alt={m.name} width="240" height="300" loading="lazy" /> : <span class="person__img" aria-hidden="true">{m.initials}</span>}
            <div class="person__txt">
              <h3 class="person__name">{m.name}</h3>
              <p class="person__role">{m.role}</p>
              {m.mark && <img class="person__mark" src={m.mark} alt="" width="90" height="40" loading="lazy" />}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ContactSection />
</Base>

<style>
  .intro { padding-block: 72px 40px; }
  .intro h1 { font-size: clamp(38px, 6vw, 84px); max-width: 15ch; }
  .all-link { padding-block: 40px 104px; display: flex; justify-content: flex-start; }

  .team { background: var(--grey-1); }
  .team__in { padding-block: 96px; display: flex; flex-wrap: wrap; gap: 48px; }
  .team h2 { flex: 1 1 240px; font-size: clamp(30px, 3.6vw, 48px); }
  .team__people { flex: 3 1 600px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 32px; }
  .person { display: flex; gap: 20px; align-items: center; }
  .person__img {
    width: 120px; height: 150px; flex: none; background: var(--petrol-l); color: #fff;
    display: flex; align-items: flex-end; padding: 10px 12px; font-size: 28px; font-weight: 700; letter-spacing: -0.02em;
  }
  .person__txt { display: flex; flex-direction: column; gap: 6px; }
  .person__name { font-size: 24px; letter-spacing: -0.02em; }
  .person__role { font-size: 15px; color: var(--text-2); }
  .person__mark { margin-top: 8px; width: 90px; height: auto; }
  .person__img--photo { padding: 0; object-fit: cover; background: var(--grey-2); }
</style>
